# Template for cli/tests/e2e/.env.e2e.local: copy it, fill in values for your local devnet, and keep it gitignored.
# Never commit the filled-in file; the pre-commit secret scan blocks key material and tokens.
SPTOOL_PATH=
PRIVATE_KEY_TEST=
PRIVATE_KEY_SP=
ADMIN_PRIVATE_KEY=
SP_PRIVATE_KEY=
CLIENT_PRIVATE_KEY=
# Optional: leave empty to read cli/tests/e2e/.lotus-token or create a fresh token with lotus
LOTUS_TOKEN=
